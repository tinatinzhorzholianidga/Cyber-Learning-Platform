# Copy to .env.local (gitignored). Every VITE_ value is public: Vite inlines
# it into the bundle. See docs/io-voice-plan.md §5.11.

# Dev only, NO VITE_ prefix: vite.config.js injects it into `npm run dev`
# (localhost) and never into a build. scripts/voice-smoke.mjs and
# scripts/voice-bakeoff.mjs read it too. Never run `vite --host` with a key here.
IO_GEMINI_KEY=

# Which voice session the Talk button starts: browser | live | turn,
# or per language, e.g. ka=browser,en=live (decided at Gate G1).
VITE_IO_VOICE_DEFAULT=browser

# 1 after `npm run smoke:voice` shows Live quota on the key (localhost only).
VITE_IO_LIVE_OK=0

# Chat backend for the browser session: gemini | openai
# (openai = a local OpenAI-compatible endpoint such as Ollama).
VITE_IO_LLM=gemini
VITE_IO_LLM_BASE=http://localhost:11434/v1
VITE_IO_LLM_MODEL=gemma3

# Gemini models (configuration, not constants - docs/io-voice-plan.md §2.1).
VITE_IO_CHAT_MODEL=gemini-3.8-flash
VITE_IO_LIVE_MODEL=gemini-3.8-live
VITE_IO_TTS_MODEL=gemini-3.1-flash-tts-preview

# speechSynthesis voice preference for the browser session (Edge: Giorgi / Eka).
VITE_IO_VOICE_NAME=Microsoft Giorgi Online (Natural)

# Gemini prebuilt voice for turn, live and the bake-off (set after Gate G1).
VITE_IO_GEMINI_VOICE=Charon

# Track P's workflow sets 1 (the build fails while src/content/safety.js
# still has placeholders). The demo builds with 0.
VITE_IO_SAFETY_REQUIRED=0

# Track P adds: VITE_IO_API_BASE=https://io-voice.<account>.workers.dev
